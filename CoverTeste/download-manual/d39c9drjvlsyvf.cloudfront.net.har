            "mimeType": "text/html",
            "text": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Strabismus Simulator</title>\n\n<link href=\"style.css\" rel=\"stylesheet\" type=\"text/css\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no\"/>\n\n<script type=\"text/javascript\" src=\"scripts/jquery-2.1.4.min.js\" defer></script>\n<script type=\"text/javascript\" src=\"scripts/Script.js\" defer></script>\n\n\n</head>\n\n<body>\n\n\n\n\n<!--<div id=\"bodyContainer\">-->\n\n\n\n\n<!--<div id=\"androidLine\"></div>-->\n\n\n<!--\n<div id=\"imageDisplayer\">\n</div>\n-->\n<!--<div id=\"loadCover\">   \n    <div id=\"loadBarContainer\">\n    \t<div id=\"loadBar\"></div>\n    \t</div>\n</div>-->\n\n\n\n\n\n\n\n<div id=\"screenDimensions\"></div>\n\n\n\n<div id=\"mainContainer\">\n\n\n<canvas id=\"canvas1\"></canvas>\n<canvas id=\"canvas2\"></canvas>\n<canvas id=\"canvas3\"></canvas>\n<canvas id=\"canvas4\"></canvas>\n\n\n<div id=\"testBox\">\n<div class=\"column\">\n<ul>\n\t<li id=\"list0\"></li>\n\t<li id=\"list1\"></li>\n\t<li id=\"list2\"></li>\n\t<li id=\"list3\"></li>\n\t<li id=\"list4\"></li>\n\t<li id=\"list5\"></li>\n\t<li id=\"list6\"></li>\n</ul>\n</div>\n\n<div class=\"column\">\n<ul>\n\t<li id=\"list7\"></li>\n\t<li id=\"list8\"></li>\n\t<li id=\"list9\"></li>\n\t<li id=\"list10\"></li>\n\t<li id=\"list11\"></li>\n\t<li id=\"list12\"></li>\n\t<li id=\"list13\"></li>\n</ul>\n</div>\n\n<div class=\"column\">\n<ul>\n\t<li id=\"list14\"></li>\n\t<li id=\"list15\"></li>\n\t<li id=\"list16\"></li>\n\t<li id=\"list17\"></li>\n\t<li id=\"list18\"></li>\n\t<li id=\"list19\"></li>\n\t<li id=\"list20\"></li>\n</ul>\n</div>\n</div>\n\n\n\n\n<div id=\"panel1\" class=\"panelBG\">\n<!--<div id=\"toggle_hidden\"></div>-->\n<!--<div id=\"patientChange\"></div>-->\n<div id=\"patientArrows\"></div>\n<div id=\"patientQuizState\">1</div>\n<div id=\"patientQuizMark\"></div>\n\n\n<div id=\"correctMark\"></div>\n<div id=\"incorrectMark\"></div>\n<!--<div id=\"toggle_dominant\"></div>-->\n<!--<div id=\"dom_OS\">OS</div>-->\n<!--<div id=\"crossOut\"></div>-->\n</div>\n\n<div id=\"panel2\" class=\"panelBG\">\n\n<div id=\"domBG\" class=\"innerPanelBG\">\n<div id=\"dom_OD\">OD</div>\n<div id=\"dom_OS\">OS</div>\n<div class=\"arrow\" id=\"toggle_dominant\"></div>\n</div>\n\n<div id=\"inputBG\" class=\"innerPanelBG\">\n<div class=\"letters\" id=\"letterX\">X</div>\n<div class=\"letters\" id=\"letterY\">Y</div>\n<div class=\"letters\" id=\"tropia\">Tropia</div>\n<div class=\"letters\" id=\"phoria\">Phoria</div>\n\n<div class=\"inputField\" id=\"inputFieldX\">0</div>\n<div class=\"arrow\" id=\"custom_tropia_X_add\"></div>\n<div class=\"arrow\" id=\"custom_tropia_X_sub\"></div>\n\n<div class=\"inputField\" id=\"inputFieldY\">0</div>\n<div class=\"arrow\" id=\"custom_tropia_Y_add\"></div>\n<div class=\"arrow\" id=\"custom_tropia_Y_sub\"></div>\n\n<div class=\"inputField\" id=\"inputFieldX_h\">0</div>\n<div class=\"arrow\" id=\"custom_phoria_X_add\"></div>\n<div class=\"arrow\" id=\"custom_phoria_X_sub\"></div>\n\n<div class=\"inputField\" id=\"inputFieldY_h\">0</div>\n<div class=\"arrow\" id=\"custom_phoria_Y_add\"></div>\n<div class=\"arrow\" id=\"custom_phoria_Y_sub\"></div>\n\n<div id=\"disableAxisCover\"></div>\n</div>\n</div>\n\n<div id=\"panel3\" class=\"panelBG\">\n<div id=\"toggle_target\" class=\"innerPanelBG\"></div>\n<div id=\"toggle_occluder\" class=\"innerPanelBG\"></div>\n<div id=\"simult_toggle\"></div>\n<div id=\"prismSetBG\" class=\"innerPanelBG\">\n<div class=\"inputField\" id=\"input_diopters\">0</div>\n<div id=\"toggle_prism\"></div>\n<div id=\"rotate_prism\"></div>\n<div class=\"arrow\" id=\"tool_prism_add\"></div>\n<div class=\"arrow\" id=\"tool_prism_sub\"></div>\n</div>\n</div>\n\n\n\n\n<div id=\"panel4\" class=\"panelBG\">\n<div id=\"quizAnswerContainer\" class=\"innerPanelBG\">\n<!----------------------------------------------------------------->\n<div class=\"arrow\" id=\"closeQuizMenu\"></div>\n<!----------------------------------------------------------------->\n<div id=\"quizDiopterColumn\">\n<div class=\"quizTitle\" id=\"quizDiopterTitle\">Δ</div>\n<div class=\"inputField quizDiopInput\" id=\"quizDiopterInput1\">0</div>\n<div class=\"inputField quizDiopInput\" id=\"quizDiopterInput2\">0</div>\n<div class=\"arrow\" id=\"quiz_arrowUp_diop1\"></div>\n<div class=\"arrow\" id=\"quiz_arrowDown_diop1\"></div>\n<div class=\"arrow\" id=\"quiz_arrowUp_diop2\"></div>\n<div class=\"arrow\" id=\"quiz_arrowDown_diop2\"></div>\n</div>\n<!----------------------------------------------------------------->\n<div id=\"quizEyeColumn\">\n<div class=\"quizTitle\" id=\"quizEyeTitle\">Eye</div>\n<div class=\"quizButton\" id=\"quizEyeField1\">N/A</div>\n<div class=\"quizButton\" id=\"quizEyeField2\">N/A</div>\n<div class=\"arrow\" id=\"quizEyeButton1\"></div>\n<div class=\"arrow\" id=\"quizEyeButton2\"></div>\n\n\n<div class=\"quizEyeMenu\" id=\"quizEyeMenu1\">\n<div id=\"left\">Left</div>\n<div id=\"quizLine\">- - - - -</div>\n<div id=\"right\">Right</div>\n<div id=\"quizLine2\">- - - - -</div>\n<div id=\"none2\">N/A</div>\n<div class=\"arrow\" id=\"left1button\"></div>\n<div class=\"arrow\" id=\"right1button\"></div>\n<div class=\"arrow\" id=\"none1button\"></div>\n</div>\n\n<div class=\"quizEyeMenu\" id=\"quizEyeMenu2\">\n<div id=\"left\">Left</div>\n<div id=\"quizLine\">- - - - -</div>\n<div id=\"right\">Right</div>\n<div id=\"quizLine2\">- - - - -</div>\n<div id=\"none2\">N/A</div>\n<div class=\"arrow\" id=\"left2button\"></div>\n<div class=\"arrow\" id=\"right2button\"></div>\n<div class=\"arrow\" id=\"none2button\"></div>\n</div>\n</div>\n\n<!----------------------------------------------------------------->\n<div id=\"quizConditionColumn\">\n\n<div class=\"quizTitle\" id=\"quizConditionTitle\">Condition</div>\n<div class=\"quizButton\" id=\"quizConditionField1\">N/A</div>\n<div class=\"quizButton\" id=\"quizConditionField2\">N/A</div>\n<div class=\"arrow\" id=\"quizConditionButton1\"></div>\n<div class=\"arrow\" id=\"quizConditionButton2\"></div>\n\n\n<div class=\"quizConditionMenu\" id=\"quizConditionMenu1\">\n<div id=\"eso\">Esotropia</div>\n<div id=\"quizLineCond1\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"exo\">Exotropia</div>\n<div id=\"quizLineCond2\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"hyper\">Hypertropia</div>\n<div id=\"quizLineCond3\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"hypo\">Hypotropia</div>\n<div id=\"quizLineCond4\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"none\">N/A</div>\n<div class=\"arrow\" id=\"eso1button\"></div>\n<div class=\"arrow\" id=\"exo1button\"></div>\n<div class=\"arrow\" id=\"hyper1button\"></div>\n<div class=\"arrow\" id=\"hypo1button\"></div>\n<div class=\"arrow\" id=\"noneC1button\"></div>\n</div>\n\n<div class=\"quizConditionMenu\" id=\"quizConditionMenu2\">\n<div id=\"eso\">Esophoria</div>\n<div id=\"quizLineCond1\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"exo\">Exophoria</div>\n<div id=\"quizLineCond2\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"hyper\">Hyperphoria</div>\n<div id=\"quizLineCond3\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"hypo\">Hypophoria</div>\n<div id=\"quizLineCond4\">- - - - - - - - - - - - - - - - -</div>\n<div id=\"none\">N/A</div>\n<div class=\"arrow\" id=\"eso2button\"></div>\n<div class=\"arrow\" id=\"exo2button\"></div>\n<div class=\"arrow\" id=\"hyper2button\"></div>\n<div class=\"arrow\" id=\"hypo2button\"></div>\n<div class=\"arrow\" id=\"noneC2button\"></div>\n</div>\n\n</div>\n\n\n\n<div id=\"incompleteMessage\">Select at least one condition.</div>\n<div id=\"submitButton\">Submit</div>\n<div id=\"diagnose\">Submit</div>\n<div id=\"patientNumber\"><span id=\"patientN\">1</span><span id=\"patientOf\"> of </span>3</div>\n<div id=\"patientNext\"><div id=\"patientNextImage\"></div></div>\n<div id=\"patientPrev\"><div id=\"patientPrevImage\"></div></div>\n\n</div><!--quizAnswerContainer end-->\n\n</div><!--panel 4 end-->\n\n\n\n\n<div id=\"panel5\" class=\"panelBG\">\n<div id=\"conditionContainer\" class=\"innerPanelBG\">\n<div id=\"tropiaContainer\">\n<div id=\"diopterID_tropia\">50 Δ Left</div>\n<!--<div id=\"dominant_tropia\">Left</div>-->\n<div id=\"conditionID_tropia\">Exotropia</div>\n</div>\n<div id=\"dashes\">- - - - - - - - - - -</div>\n<div id=\"phoriaContainer\">\n<div id=\"diopterID_phoria\">15 Δ Right</div>\n<!--<div id=\"dominant_phoria\">Right</div>-->\n<div id=\"conditionID_phoria\">Hyperphoria</div>\n</div>\n</div>\n</div>\n\n\n\n<div id=\"homeButton\"><div id=\"homeButtonImage\"></div></div>\n<div id=\"modeText\">---</div>\n<div id=\"helpButton\"></div>\n<div id=\"testResetButton\">Try Three<br/>New Patients</div>\n\n\n\n<div id=\"scoreBG\">\n\t<div id=\"scoreTitle\">Score:</div>\n    <div id=\"scoreNumber\">0/3</div>\n    <!--<div class=\"closeWindow\" id=\"closeScore\"></div>-->\n    <div class=\"continueBT\" id=\"continueScore\">Review Answers</div>\n</div>\n\n<!--\n<div id=\"loadingCover\">\n<div id=\"loadingText\">Loading</div>\n</div>\n-->\n\n<div id=\"panelHide\"></div>\n\n\n<div id=\"loadPatientsCover\">Generating new patients...</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<div id=\"instructContainer\">\n\n\t<div id=\"screenshotContainer\"></div>\n    <div id=\"overlayContainer\">\n    \n    <div id=\"instructStart\">Instructions</div>\n    <div id=\"instructSkip\">Start Simulator</div>\n    <div id=\"instructNext\">Next &#9658</div>\n    <div id=\"instructVideo\">Video Tutorial</div>\n    \n    </div>\n    \n    <div id=\"instructExit\"></div>\n\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<div id=\"menuContainer\">\n\n<div id=\"menuBorder\"></div>\n<div id=\"menuBG\">\n\t<div class=\"menuCircle\" id=\"menuCircle1\"></div>\n\t<div class=\"menuCircle\" id=\"menuCircle2\"></div>\n</div>\n\n<div id=\"moduleTitle\"></div>\n\n<div class=\"menuButton\" id=\"menuReviewButton\">\n<div id=\"menuReviewButtonTitle\">Explore Mode</div>\n<div id=\"menuReviewButtonInfo\">Learn how various deviations<br/>appear through cover testing</div>\n</div>\n<div class=\"menuButton\" id=\"menuTestButton\">\n<div id=\"menuTestButtonTitle\">Test Mode</div>\n<div id=\"menuTestButtonInfo\">Evaluate for strabismus in<br/>three randomized patients</div>\n</div>\n\n\n<div id=\"creditContainer\">\n\t\n    <div id=\"creditBoxContainer\">\n    \t<div id=\"creditTitle\">Acknowledgment</div>\n   \t  \t<div class=\"creditBox\" id=\"creditBox1\">\n       \t\t<p class=\"creditBold\">Faruk H. Örge, MD</p>\n            <div class=\"creditRegular\">\n        \t<p>William R. and Margaret E. Althans Professor and Director</p>\n        \t<p>Center for Pediatric Ophthalmology and Adult Strabismus</p>\n        \t<p>University Hospitals Eye Institute</p>\n\t\t\t<p>Department of Ophthalmology and Visual Sciences</p>\n\t\t\t<p>Case Western Reserve University School of Medicine</p>\n            </div>     \n        </div>\n    </div>\n\t\n    <div id=\"startButton\">Start</div>\n\n</div><!--END: creditContainer-->\n<div class=\"menuSubButton\" id=\"creditButtonNew\">Acknowledgment</div>\n\n\n\n\n<!--<div class=\"menuSubButtonsNew\" id=\"creditButtonNew\">Acknowledgment</div>-->\n\n\n<div id=\"copyright\">© 2015  American Academy of Ophthalmology</div>\n\n\n</div><!-- END: menuContainer-->\n\n\n\n\n</div><!--mainContainer-->\n\n\n\n<!--</div>end: body container-->\n\n\n\n\n\n\n</body>\n</html>\n"
